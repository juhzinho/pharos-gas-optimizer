{
  "name": "pharos-gas-optimizer",
  "version": "1.0.0",
  "description": "A SkillEngine skill for Pharos Pacific that watches the fee market, holds non-urgent transactions until gas is favorable, and always submits by the deadline.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "gas": "node tasks/gas/gas.js",
    "web": "node scripts/dev-server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": { "viem": "^2.57.5" },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1"
  }
}
