# Only needed if YOU sign the ladder with this tool. The agent itself never needs a key.
# SENDER_PRIVATE_KEY=0x…        # "sign": signs every rung of a queued job, locally (or sign elsewhere and "attach")
# PHAROS_RPC_URL=https://rpc.pharos.xyz
# PHAROS_RPC_CONCURRENCY=2
# ANVIL_BIN=                    # an Anvil binary for the fork demo (default: the npm package)
# FORK_PORT=8555
# PORT=3160                     # the local demo site
